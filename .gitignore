# === Skylink Bingwa root .gitignore ===
# Protects build output, secrets, keystores, local machine state and IDE files
# across the whole repository. Module-level .gitignore files also apply.

# --- Secrets & signing (NEVER COMMIT) ---
# Debug builds use AGP's auto-generated ~/.android/debug.keystore, never a committed one.
*.jks
*.keystore
*.p12
*.pem
*.der
*.key
my-bingwa-b538e0f6c645.json
google-services.json
google-services*.json
GoogleService-Info.plist
service-account*.json
play-service-account*.json
my-bingwa-*.json
skylink-bingwa-*.json
*-*.json
*.env
.env
.env.*
!.env.example
secrets.properties
keystore.properties
signing.properties

# --- Gradle ---
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/**/build/
build-cache/

# --- Android / SDK local config ---
local.properties
*.iml
.cxx/
.externalNativeBuild/
captures/
output.json
*.apk
*.aab
*.ap_
*.dex
*.class
mapping.txt

# --- Kotlin ---
.kotlin/

# --- IDE (Android Studio / IntelliJ / VS Code) ---
.idea/
.vscode/
*.swp
*~

# --- Firebase / tooling logs ---
*firebase-debug.log*
*firebase-debug.*.log*
.firebase/
firestore-debug.log
ui-debug.log

# --- OS / misc ---
.DS_Store
Thumbs.db
desktop.ini
*.log

# Server: real payment config holds Daraja secrets — never commit it.
server/mybingwa-api/config.php

# Admin V2: real config, signing keys, uploaded images and runtime storage.
server/admin-v2/config/config.php
server/admin-v2/config/*.pem
server/admin-v2/config/*.key
server/admin-v2/**/*.pem
server/admin-v2/**/*.key
server/admin-v2/uploads/*
!server/admin-v2/uploads/.htaccess
server/admin-v2/storage/*
!server/admin-v2/storage/.htaccess
!server/admin-v2/storage/.gitkeep
server/admin-v2/vendor/

# Generated cPanel upload packages (server/tools/build-deploy-package.ps1).
server/dist/

# --- Hard secret/config guard (also enforced locally by .githooks/pre-commit) ---
# Real runtime config holds live secrets and must NEVER be committed. Only the
# *.sample.php templates (placeholders) are tracked. Rotate + purge if leaked.
**/config.php
config.local.php
config.production.php
*.secret
secrets.php
# Keep tracked templates/source that the broad pattern above would otherwise ignore:
!**/config.sample.php
!server/admin-v2/app/Core/Config.php
