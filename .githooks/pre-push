#!/bin/sh
# Skylink Bingwa push guard: refuse to push commits that add a runtime config.php.
# Emergency bypass (only if you are 100% certain): git push --no-verify
z=0000000000000000000000000000000000000000
fail=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z" ] && continue    # branch deletion
  if [ "$remote_sha" = "$z" ]; then
    range="$local_sha"                    # new branch: scan all its commits
  else
    range="$remote_sha..$local_sha"
  fi
  hit=$(git log --name-only --diff-filter=A --pretty=format: "$range" 2>/dev/null \
    | grep -E '(^|/)config\.php$' | sort -u || true)
  if [ -n "$hit" ]; then
    echo "BLOCKED push: these incoming commits add a runtime config.php:"
    printf '%s\n' "$hit" | sed 's/^/    /'
    fail=1
  fi
done
if [ "$fail" -ne 0 ]; then
  echo "Push rejected by .githooks/pre-push (config guard)."
fi
exit $fail
