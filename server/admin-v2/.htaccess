# Skylink Bingwa Admin V2 — front-controller routing. Kept maximally compatible with shared
# Apache/LiteSpeed hosts (no bare Options/Require that AllowOverride might reject).
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Serve real files (assets, uploaded images) directly.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # Everything else -> the single front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Block direct download of source/data files (portable across Apache 2.2/2.4 + LiteSpeed).
<FilesMatch "\.(sql|log|pem|key|dist|sample)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
