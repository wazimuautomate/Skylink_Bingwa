# Block the web from downloading internal files. The public endpoints
# (stk.php, status.php, callback.php, register_user.php, the referral/Earn
# endpoints and the B2C result/timeout URLs) stay reachable.
#
# referrals.php, b2c.php and fcm.php are LIBRARIES, not endpoints: they define
# functions and must never be requested directly. cron_referrals.php stays
# reachable because cPanel cron may call it over HTTP, but it refuses any request
# without the cron_key.
<FilesMatch "^(config|config\.sample|db|lib|offers|referrals|b2c|fcm)\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|md|log|json)$">
    Require all denied
</FilesMatch>
# The Daraja B2C public-key certificate (b2c_cert_path in config.php). Not a
# secret in itself -- it's Safaricom's PUBLIC key -- but it only needs to be
# read from local disk by openssl_pkey_get_public(), never fetched over HTTP,
# so there's no reason to leave it web-reachable.
<FilesMatch "\.(cer|pem|crt|der|key)$">
    Require all denied
</FilesMatch>
